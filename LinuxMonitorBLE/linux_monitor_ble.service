[Unit]
Description=Linux Monitor BLE — ESP32 Telemetry Sender
After=bluetooth.target network.target
Wants=bluetooth.target

[Service]
Type=simple
# Thay thế /path/to/desktop-monitoring/LinuxMonitorBLE bằng đường dẫn thực tế trên máy bạn
WorkingDirectory=%h/desktop-monitoring/LinuxMonitorBLE
ExecStart=%h/desktop-monitoring/LinuxMonitorBLE/.venv/bin/python3 main.py --daemon
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
